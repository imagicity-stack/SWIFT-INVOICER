{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores user-specific company settings and preferences for Swift",
      "type": "object",
      "properties": {
        "settings": { "type": "object" },
        "templateId": { "type": "string" }
      },
      "required": ["settings", "templateId"]
    },
    "Invoice": {
      "title": "Invoice Record",
      "description": "Stores a single generated invoice and its metadata",
      "type": "object",
      "properties": {
        "invoiceNumber": { "type": "string" },
        "date": { "type": "string" },
        "dueDate": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerAddress": { "type": "string" },
        "items": { "type": "array" },
        "customFields": { "type": "array" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["invoiceNumber", "date", "customerName", "items"]
    }
  },
  "firestore": {
    "/swift_users/{userId}": {
      "schema": "User",
      "description": "Main user settings document for the Swift application"
    },
    "/swift_users/{userId}/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Collection of invoices generated by the user"
    }
  }
}
