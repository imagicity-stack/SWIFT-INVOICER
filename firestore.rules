rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- User Profile Validation ---
    function isValidSwiftUser(data) {
      return data.keys().hasAll(['settings', 'templateId'])
        && data.settings is map
        && data.templateId is string
        && data.templateId.size() <= 32
        && isValidSettings(data.settings);
    }

    function isValidSettings(s) {
      return s.get('name', '') is string && s.get('name', '').size() <= 100
        && s.get('email', '') is string && s.get('email', '').size() <= 100
        && s.get('address', '') is string && s.get('address', '').size() <= 1000
        && s.get('phone', '') is string && s.get('phone', '').size() <= 50
        && (s.get('logoUrl', null) == null || (s.get('logoUrl', '') is string && s.get('logoUrl', '').size() <= 500))
        && s.get('gstNumber', '') is string && s.get('gstNumber', '').size() <= 20
        && s.get('panNumber', '') is string && s.get('panNumber', '').size() <= 20
        && s.get('state', '') is string && s.get('state', '').size() <= 50
        && s.get('addressStateCode', '') is string && s.get('addressStateCode', '').size() <= 10
        && s.get('aboutSection', '') is string && s.get('aboutSection', '').size() <= 1000
        && s.get('bankName', '') is string && s.get('bankName', '').size() <= 100
        && s.get('accountNumber', '') is string && s.get('accountNumber', '').size() <= 100
        && s.get('ifscCode', '') is string && s.get('ifscCode', '').size() <= 20
        && s.get('branchName', '') is string && s.get('branchName', '').size() <= 100
        && s.get('defaultTaxRate', 0) is number && s.get('defaultTaxRate', 0) >= 0 && s.get('defaultTaxRate', 0) <= 100
        && s.get('currency', '') is string && s.get('currency', '').size() <= 50
        && s.get('nextInvoiceNumber', 0) is int && s.get('nextInvoiceNumber', 0) >= 0
        && s.get('invoicePrefix', '') is string && s.get('invoicePrefix', '').size() <= 20;
    }

    // --- Collection Rules ---

    match /swift_users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidSwiftUser(request.resource.data);
      allow update: if isOwner(userId) && isValidSwiftUser(request.resource.data)
        && (
          // Allow full updates to settings and template
          request.resource.data.diff(resource.data).affectedKeys().hasAny(['settings', 'templateId'])
        );

      match /invoices/{invoiceId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
